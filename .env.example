# Variables d'environnement — OSPM
# Copier ce fichier en .env et remplir les valeurs

# --- Base de données (PostgreSQL) ---
# En local (Docker) :
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ospm?schema=public"
# Sur Render, cette variable est injectée automatiquement depuis la base liée.

# --- Sécurité des sessions ---
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET="chaine-longue-et-aleatoire-min-32-caracteres"

# --- Agent d'impression thermique (optionnel) ---
# Jeton partagé entre le serveur et l'agent local ESC/POS
OSPM_AGENT_TOKEN="jeton-secret-impression"

# --- URL publique du site ---
# En local :
OSPM_URL="http://localhost:3000"
# En production Render (ex: https://ospm.onrender.com) :
# OSPM_URL="https://votre-service.onrender.com"
