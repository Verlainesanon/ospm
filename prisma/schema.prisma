// Schema OSPM (Official Services Printing and More) - PostgreSQL.
// Convention : les enums metier sont des String documentees (portable, editable
// depuis l'admin sans migration), les listes sont stockees en JSON string.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Utilisateurs

// role : ADMIN | GESTIONNAIRE | CAISSIER | TECHNICIEN
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  nom       String
  password  String
  role      String   @default("TECHNICIEN")
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  commandes    Order[]         @relation("OrderAssignee")
  mouvements   CashMovement[]
  depenses     Expense[]
  auditLogs    AuditLog[]
  maintenances Maintenance[]
  stockMouv    StockMovement[]
  printJobs    PrintJob[]
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entite    String
  entiteId  String?
  details   String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([entite, entiteId])
  @@index([createdAt])
}

// ---------------------------------------------------------------- Contenu du site

// Cle/valeur pour tout ce qui est editable globalement : coordonnees, reseaux,
// slogan, textes du hero, devise par defaut, taux de change, etc.
model SiteSetting {
  key       String   @id
  value     String
  groupe    String   @default("general")
  label     String
  type      String   @default("text") // text | textarea | image | number | bool | color
  ordre     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  titre     String
  contenu   String   @default("")
  metaDesc  String?
  publiee   Boolean  @default(true)
  ordre     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model ServiceCategory {
  id          String    @id @default(cuid())
  slug        String    @unique
  nom         String
  icone       String    @default("")
  description String    @default("")
  couleur     String    @default("bleu") // bleu | rouge | creme
  ordre       Int       @default(0)
  visible     Boolean   @default(true)
  services    Service[]
}

model Service {
  id              String          @id @default(cuid())
  slug            String          @unique
  nom             String
  description     String          @default("")
  image           String?
  prixBase        Decimal?        @db.Decimal(12, 2)
  devise          String          @default("HTG")
  unite           String          @default("unite") // unite | m2 | page | heure | forfait
  surDevis        Boolean         @default(false)
  vendableEnLigne Boolean         @default(false)
  ordre           Int             @default(0)
  visible         Boolean         @default(true)
  categorieId     String
  categorie       ServiceCategory @relation(fields: [categorieId], references: [id], onDelete: Cascade)
  options         ServiceOption[]
  quoteItems      QuoteItem[]
  orderItems      OrderItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([categorieId])
}

// Variantes facturables : "lamine", "avec hologramme", "taille XL"...
model ServiceOption {
  id         String  @id @default(cuid())
  serviceId  String
  service    Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  nom        String
  supplement Decimal @default(0) @db.Decimal(12, 2)
  ordre      Int     @default(0)

  @@index([serviceId])
}

model GalleryItem {
  id        String   @id @default(cuid())
  titre     String
  image     String
  categorie String   @default("impression")
  ordre     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Testimonial {
  id      String  @id @default(cuid())
  auteur  String
  role    String?
  texte   String
  note    Int     @default(5)
  visible Boolean @default(true)
  ordre   Int     @default(0)
}

model ContactMessage {
  id        String   @id @default(cuid())
  nom       String
  email     String?
  telephone String?
  sujet     String   @default("")
  message   String
  lu        Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------- Clients

model Customer {
  id        String   @id @default(cuid())
  nom       String
  type      String   @default("PARTICULIER") // PARTICULIER | ENTREPRISE | ECOLE | INSTITUTION
  email     String?
  telephone String?
  whatsapp  String?
  adresse   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes   Quote[]
  orders   Order[]
  invoices Invoice[]

  @@index([nom])
}

// ---------------------------------------------------------------- Devis

// statut : NOUVEAU | ENVOYE | ACCEPTE | REFUSE | EXPIRE
model Quote {
  id         String       @id @default(cuid())
  numero     String       @unique
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id])
  nomContact String
  email      String?
  telephone  String?
  message    String       @default("")
  statut     String       @default("NOUVEAU")
  devise     String       @default("HTG")
  total      Decimal      @default(0) @db.Decimal(12, 2)
  validJusqu DateTime?
  items      QuoteItem[]
  fichiers   Attachment[]
  order      Order?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([statut])
}

model QuoteItem {
  id           String   @id @default(cuid())
  quoteId      String
  quote        Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceId    String?
  service      Service? @relation(fields: [serviceId], references: [id])
  designation  String
  details      String   @default("")
  quantite     Int      @default(1)
  prixUnitaire Decimal  @default(0) @db.Decimal(12, 2)

  @@index([quoteId])
}

// Fichiers envoyes par le client (logo, maquette) ou joints en interne.
model Attachment {
  id        String   @id @default(cuid())
  url       String
  nom       String
  mime      String   @default("")
  taille    Int      @default(0)
  quoteId   String?
  quote     Quote?   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------- Commandes

// statut : NOUVELLE | CONFIRMEE | EN_PRODUCTION | PRETE | LIVREE | ANNULEE
model Order {
  id            String           @id @default(cuid())
  numero        String           @unique
  customerId    String?
  customer      Customer?        @relation(fields: [customerId], references: [id])
  nomContact    String
  telephone     String?
  email         String?
  adresse       String?
  origine       String           @default("SITE") // SITE | BOUTIQUE | TELEPHONE
  statut        String           @default("NOUVELLE")
  priorite      String           @default("NORMALE") // BASSE | NORMALE | URGENTE
  devise        String           @default("HTG")
  sousTotal     Decimal          @default(0) @db.Decimal(12, 2)
  remise        Decimal          @default(0) @db.Decimal(12, 2)
  total         Decimal          @default(0) @db.Decimal(12, 2)
  notes         String           @default("")
  dateLivraison DateTime?
  assigneId     String?
  assigne       User?            @relation("OrderAssignee", fields: [assigneId], references: [id])
  quoteId       String?          @unique
  quote         Quote?           @relation(fields: [quoteId], references: [id])
  items         OrderItem[]
  fichiers      Attachment[]
  historique    OrderStatusLog[]
  invoices      Invoice[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([statut])
  @@index([createdAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId    String?
  service      Service? @relation(fields: [serviceId], references: [id])
  designation  String
  details      String   @default("")
  quantite     Int      @default(1)
  prixUnitaire Decimal  @default(0) @db.Decimal(12, 2)

  @@index([orderId])
}

model OrderStatusLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ancien    String?
  nouveau   String
  parQui    String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

// ---------------------------------------------------------------- Finance

// type : PROFORMA | FACTURE | RECU
// statut : BROUILLON | EMISE | PARTIELLE | PAYEE | ANNULEE
model Invoice {
  id           String        @id @default(cuid())
  numero       String        @unique
  type         String        @default("FACTURE")
  statut       String        @default("BROUILLON")
  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id])
  orderId      String?
  order        Order?        @relation(fields: [orderId], references: [id])
  nomClient    String
  devise       String        @default("HTG")
  tauxChange   Decimal       @default(1) @db.Decimal(12, 4)
  sousTotal    Decimal       @default(0) @db.Decimal(12, 2)
  remise       Decimal       @default(0) @db.Decimal(12, 2)
  taxe         Decimal       @default(0) @db.Decimal(12, 2)
  total        Decimal       @default(0) @db.Decimal(12, 2)
  montantPaye  Decimal       @default(0) @db.Decimal(12, 2)
  notes        String        @default("")
  dateEmission DateTime      @default(now())
  dateEcheance DateTime?
  items        InvoiceItem[]
  paiements    Payment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([statut])
  @@index([dateEmission])
}

model InvoiceItem {
  id           String  @id @default(cuid())
  invoiceId    String
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  designation  String
  details      String  @default("")
  quantite     Int     @default(1)
  prixUnitaire Decimal @default(0) @db.Decimal(12, 2)

  @@index([invoiceId])
}

// methode : ESPECES | MONCASH | NATCASH | CHEQUE | VIREMENT | CARTE
model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  montant   Decimal       @db.Decimal(12, 2)
  devise    String        @default("HTG")
  methode   String        @default("ESPECES")
  reference String?
  date      DateTime      @default(now())
  cashMove  CashMovement?

  @@index([invoiceId])
}

// Caisse : une session par jour/caissier, mouvements ENTREE | SORTIE.
model CashSession {
  id             String         @id @default(cuid())
  ouvertePar     String
  soldeOuverture Decimal        @default(0) @db.Decimal(12, 2)
  soldeCloture   Decimal?       @db.Decimal(12, 2)
  ouverteLe      DateTime       @default(now())
  fermeeLe       DateTime?
  notes          String         @default("")
  mouvements     CashMovement[]
}

model CashMovement {
  id        String       @id @default(cuid())
  sessionId String?
  session   CashSession? @relation(fields: [sessionId], references: [id])
  sens      String       @default("ENTREE")
  montant   Decimal      @db.Decimal(12, 2)
  devise    String       @default("HTG")
  motif     String
  paymentId String?      @unique
  payment   Payment?     @relation(fields: [paymentId], references: [id])
  expenseId String?      @unique
  expense   Expense?     @relation(fields: [expenseId], references: [id])
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  date      DateTime     @default(now())

  @@index([date])
}

model ExpenseCategory {
  id       String    @id @default(cuid())
  nom      String    @unique
  couleur  String    @default("#1d4ed8")
  depenses Expense[]
}

model Expense {
  id           String           @id @default(cuid())
  categorieId  String?
  categorie    ExpenseCategory? @relation(fields: [categorieId], references: [id])
  libelle      String
  montant      Decimal          @db.Decimal(12, 2)
  devise       String           @default("HTG")
  methode      String           @default("ESPECES")
  fournisseur  String?
  justificatif String?
  date         DateTime         @default(now())
  userId       String?
  user         User?            @relation(fields: [userId], references: [id])
  cashMove     CashMovement?
  createdAt    DateTime         @default(now())

  @@index([date])
}

// ---------------------------------------------------------------- Stock

model Supplier {
  id        String      @id @default(cuid())
  nom       String
  telephone String?
  email     String?
  adresse   String?
  notes     String?
  articles  StockItem[]
}

model StockItem {
  id            String                @id @default(cuid())
  reference     String                @unique
  nom           String
  categorie     String                @default("fourniture") // fourniture | consommable | produit_fini
  unite         String                @default("unite")
  quantite      Decimal               @default(0) @db.Decimal(12, 2)
  seuilAlerte   Decimal               @default(0) @db.Decimal(12, 2)
  prixAchat     Decimal               @default(0) @db.Decimal(12, 2)
  devise        String                @default("HTG")
  fournisseurId String?
  fournisseur   Supplier?             @relation(fields: [fournisseurId], references: [id])
  mouvements    StockMovement[]
  equipements   EquipmentConsumable[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

// sens : ENTREE | SORTIE | AJUSTEMENT
model StockMovement {
  id       String    @id @default(cuid())
  itemId   String
  item     StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sens     String
  quantite Decimal   @db.Decimal(12, 2)
  motif    String    @default("")
  refOrder String?
  userId   String?
  user     User?     @relation(fields: [userId], references: [id])
  date     DateTime  @default(now())

  @@index([itemId])
  @@index([date])
}

// ---------------------------------------------------------------- Materiel & imprimantes

// type : IMPRIMANTE | PRESSE | APPAREIL_PHOTO | ORDINATEUR | PLASTIFIEUSE | AUTRE
// etat : OK | MAINTENANCE | PANNE | HORS_SERVICE
model Equipment {
  id            String                @id @default(cuid())
  nom           String
  type          String                @default("IMPRIMANTE")
  marque        String?
  modele        String?
  numeroSerie   String?
  etat          String                @default("OK")
  emplacement   String                @default("Atelier")
  dateAchat     DateTime?
  prixAchat     Decimal?              @db.Decimal(12, 2)
  garantieJusqu DateTime?
  notes         String                @default("")
  printer       Printer?
  maintenances  Maintenance[]
  consommables  EquipmentConsumable[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model EquipmentConsumable {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  itemId      String
  item        StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([equipmentId, itemId])
}

// type : PREVENTIVE | REPARATION
model Maintenance {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  type        String    @default("PREVENTIVE")
  description String
  cout        Decimal   @default(0) @db.Decimal(12, 2)
  technicien  String?
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  date        DateTime  @default(now())
  prochaineLe DateTime?

  @@index([equipmentId])
}

// ---------------------------------------------------------------- Impression

// Imprimante utilisable par le navigateur ou par l'agent local.
// transport : BROWSER | ESCPOS
model Printer {
  id          String     @id @default(cuid())
  nom         String
  equipmentId String?    @unique
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])
  transport   String     @default("BROWSER")
  cible       String     @default("") // nom systeme Windows, IP:port ou chemin USB
  largeurMm   Int        @default(80)
  parDefaut   Boolean    @default(false)
  actif       Boolean    @default(true)
  jobs        PrintJob[]
  createdAt   DateTime   @default(now())
}

// Gabarits imprimables editables depuis l'admin (HTML + placeholders).
// type : FACTURE | RECU | BADGE | ETIQUETTE | BON_TRAVAIL
model PrintTemplate {
  id        String     @id @default(cuid())
  cle       String     @unique
  nom       String
  type      String     @default("FACTURE")
  largeurMm Int        @default(210)
  hauteurMm Int        @default(297)
  html      String
  css       String     @default("")
  actif     Boolean    @default(true)
  jobs      PrintJob[]
  updatedAt DateTime   @updatedAt
}

// File d'attente lue par l'agent local. statut : EN_ATTENTE | IMPRIME | ERREUR
model PrintJob {
  id         String         @id @default(cuid())
  printerId  String?
  printer    Printer?       @relation(fields: [printerId], references: [id])
  templateId String?
  template   PrintTemplate? @relation(fields: [templateId], references: [id])
  titre      String
  payload    String         @default("{}")
  rendu      String         @default("")
  copies     Int            @default(1)
  statut     String         @default("EN_ATTENTE")
  erreur     String?
  userId     String?
  user       User?          @relation(fields: [userId], references: [id])
  createdAt  DateTime       @default(now())
  imprimeLe  DateTime?

  @@index([statut])
}

// Compteurs de numerotation (FAC-2026-0001, CMD-..., DEV-...).
model Counter {
  cle    String @id
  annee  Int
  valeur Int    @default(0)
}
